# Supabase Configuration
# Get these from Supabase Dashboard > Settings > API

# Required: Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Required: Supabase Anonymous Key (for client-side auth)
SUPABASE_ANON_KEY=your-anon-key-here

# Vite aliases (used in browser environment)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Notes:
# 1. Copy this file to .env.local (local development)
# 2. Never put the service role or secret key in this file
