# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Scraper Configuration
# SERVICE: The type of business/service to search (e.g., "plumber", "electrician")
SERVICE=plumber

# REGION: The region/city to search in (e.g., "São Paulo", "Brasília")
REGION=São Paulo

# Optional: Scraper behavior
HEADLESS=true
MAX_RETRIES=3
DELAY_MIN_MS=2000
DELAY_MAX_MS=5000
